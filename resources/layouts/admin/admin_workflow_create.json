{
  "version": "1.0.0",
  "layout_name": "admin_workflow_create",
  "permissions": ["glitter-workflow.workflows.create"],
  "extends": "_admin_base",
  "meta": {"title": "$t:glitter-workflow.admin.workflows.create_page.title", "description": "$t:glitter-workflow.admin.workflows.create_page.description"},
  "initActions": [{"handler": "setState", "params": {"target": "local", "form": {"name": "", "trigger_key": "user.registered", "trigger_config": {}, "condition_tree": {"group": "all", "children": []}, "action_plan": [{"index": 0, "type": "delay", "config": {"delay_seconds": 60}}]}}}],
  "slots": {"content": [{"id": "admin_workflow_create_content", "type": "basic", "name": "Div", "props": {"className": "admin-page-content"}, "children": [
    {"id": "page_header", "type": "composite", "name": "PageHeader", "props": {"title": "$t:glitter-workflow.admin.workflows.create_page.title", "description": "$t:glitter-workflow.admin.workflows.create_page.description"}},
    {"id": "workflow_form", "type": "basic", "name": "Form", "props": {"className": "workflow-definition-form"}, "children": [
      {"id": "name_field", "type": "basic", "name": "Div", "props": {"className": "form-group"}, "children": [{"type": "basic", "name": "Label", "props": {"className": "form-label"}, "text": "$t:glitter-workflow.admin.workflows.name"}, {"id": "name", "type": "basic", "name": "Input", "props": {"name": "name", "value": "{{_local.form?.name ?? ''}}", "required": true}, "actions": [{"type": "change", "handler": "setState", "params": {"target": "local", "form.name": "{{$event.target.value}}"}}]}]},
      {"id": "trigger_field", "type": "basic", "name": "Div", "props": {"className": "form-group"}, "children": [{"type": "basic", "name": "Label", "props": {"className": "form-label"}, "text": "$t:glitter-workflow.admin.workflows.when"}, {"id": "trigger", "type": "basic", "name": "Select", "props": {"name": "trigger_key", "value": "{{_local.form?.trigger_key ?? 'user.registered'}}", "options": [{"label": "$t:glitter-workflow.admin.workflows.triggers.user_registered", "value": "user.registered"}, {"label": "$t:glitter-workflow.admin.workflows.triggers.user_updated", "value": "user.updated"}, {"label": "$t:glitter-workflow.admin.workflows.triggers.board_post_created", "value": "board.post.created"}, {"label": "$t:glitter-workflow.admin.workflows.triggers.board_comment_created", "value": "board.comment.created"}]}, "actions": [{"type": "change", "handler": "setState", "params": {"target": "local", "form.trigger_key": "{{$event.target.value}}"}}]}]},
      {"id": "group_field", "type": "basic", "name": "Div", "props": {"className": "form-group"}, "children": [{"type": "basic", "name": "Label", "props": {"className": "form-label"}, "text": "$t:glitter-workflow.admin.workflows.if_group"}, {"id": "group", "type": "basic", "name": "Select", "props": {"name": "condition_tree.group", "value": "{{_local.form?.condition_tree?.group ?? 'all'}}", "options": [{"label": "$t:glitter-workflow.admin.workflows.groups.all", "value": "all"}, {"label": "$t:glitter-workflow.admin.workflows.groups.any", "value": "any"}]}, "actions": [{"type": "change", "handler": "setState", "params": {"target": "local", "form.condition_tree.group": "{{$event.target.value}}"}}]}]},
      {"id": "action_field", "type": "basic", "name": "Div", "props": {"className": "form-group"}, "children": [{"type": "basic", "name": "Label", "props": {"className": "form-label"}, "text": "$t:glitter-workflow.admin.workflows.then"}, {"id": "action", "type": "basic", "name": "Select", "props": {"name": "action_plan.0.type", "value": "{{_local.form?.action_plan?.[0]?.type ?? 'delay'}}", "options": [{"label": "$t:glitter-workflow.admin.workflows.actions.webhook", "value": "webhook"}, {"label": "$t:glitter-workflow.admin.workflows.actions.delay", "value": "delay"}]}, "actions": [{"type": "change", "handler": "setState", "params": {"target": "local", "form.action_plan.0.type": "{{$event.target.value}}"}}]}]},
      {"id": "delay_field", "type": "basic", "name": "Div", "props": {"className": "form-group"}, "children": [{"type": "basic", "name": "Label", "props": {"className": "form-label"}, "text": "$t:glitter-workflow.admin.workflows.delay_seconds"}, {"id": "delay", "type": "basic", "name": "Input", "props": {"name": "action_plan.0.config.delay_seconds", "value": "{{_local.form?.action_plan?.[0]?.config?.delay_seconds ?? 60}}", "type": "number"}, "actions": [{"type": "change", "handler": "setState", "params": {"target": "local", "form.action_plan.0.config.delay_seconds": "{{Number($event.target.value)}}"}}]}]},
      {"id": "footer_buttons", "type": "basic", "name": "Div", "props": {"className": "sticky-footer-buttons"}, "children": [{"id": "save", "type": "basic", "name": "Button", "props": {"type": "button"}, "actions": [{"type": "click", "handler": "apiCall", "auth_required": true, "target": "/api/modules/glitter-workflow/admin/workflows", "params": {"method": "POST", "body": {"name": "{{_local.form?.name ?? ''}}", "trigger_key": "{{_local.form?.trigger_key}}", "trigger_config": "{{_local.form?.trigger_config ?? {}}}", "condition_tree": "{{_local.form?.condition_tree ?? null}}", "action_plan": "{{_local.form?.action_plan ?? []}}"}}, "onSuccess": [{"handler": "navigate", "params": {"path": "/admin/glitter-workflow/workflows/{{response.data.uuid}}"}}], "onError": [{"handler": "setState", "params": {"target": "local", "errors": "{{error.errors}}"}}, {"handler": "toast", "params": {"type": "error", "message": "$t:glitter-workflow.admin.workflows.save_error"}}]}], "children": [{"id": "save_label", "type": "basic", "name": "Span", "text": "$t:glitter-workflow.admin.workflows.save"}]}]}
    ]}
  ]}]}
}
